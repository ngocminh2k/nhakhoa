# Environment configuration for Nha Khoa Kim Dung
APP_ENV=production
APP_URL=https://nhakhoakimdung.vn

# Database (MariaDB / MySQL on Mắt Bão Cloud Hosting)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nhakhoa_db
DB_USER=nhakhoa_user
DB_PASS=your_strong_password_here

# Google Sheets Sync (Optional until service account is configured)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_RANGE=Bookings!A:N
GOOGLE_SERVICE_ACCOUNT_JSON=../credentials/google-service-account.json

# API Key for external automation posting
AUTOMATION_API_KEY=kd_live_sec_7a8f9b2c3d4e5f6a1b2c3d4e5f6a7b8c
